def _get_lexicons(self) -&gt; tuple[str, ...]:
    if self._lexconf.default_mode:
        return (
            self._lexicon,
            *get_lexicon_extension_bases(self._lexicon),
            *get_lexicon_extensions(self._lexicon),
        )
    else:

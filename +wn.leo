<t tx="karstenw.20230225124217.11">def _find_file(self, base: Path, suffixes: tuple[str, ...]) -&gt; Path | None:
    for suffix in suffixes:
        base = base.with_suffix(suffix)
        if base.is_file():
            return base
    return None



    if tablename is None:
        raise Error(f"'{table}' does not contain metadata")
    query = f"""
        SELECT tbl.metadata
          FROM {tablename} AS tbl
          JOIN lexicons AS lex ON lex.rowid = lexicon_rowid
         WHERE tbl.id=?
           AND lex.specifier = ?
    """
    return cast(
        "Metadata",

<t tx="karstenw.20230225123218.9">def _batch(sequence: Iterable[T]) -&gt; Iterator[list[T]]:
    it = iter(sequence)
    batch = list(islice(it, 0, BATCH_SIZE))
    while len(batch):
        yield batch
        batch = list(islice(it, 0, BATCH_SIZE))


